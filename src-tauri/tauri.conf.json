{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QMem",
  "version": "1.0.0",
  "identifier": "app.qmem.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "QMem", "width": 700, "height": 560, "minWidth": 320, "minHeight": 240, "visible": false }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost" }
  },
  "bundle": { "active": true, "targets": ["app", "dmg"], "icon": ["icons/32x32.png"] }
}
